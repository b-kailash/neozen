# NeoZen Web Interface Docker Image
# Minimal container for browser-based Nmap GUI

FROM python:3.11-slim

LABEL maintainer="NeoZen Project"
LABEL description="Modern Nmap Web GUI"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    curl \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 neozen

# Fix hostname resolution for sudo (prevents "unable to resolve host" warning)
RUN echo "127.0.0.1 neozen-web" >> /etc/hosts

# Allow neozen user to run nmap and chown as root without password
# nmap: required for OS detection, SYN scans, etc.
# chown: required to change temp file ownership so nmap can write to it
RUN echo "neozen ALL=(root) NOPASSWD: /usr/bin/nmap, /usr/bin/chown" > /etc/sudoers.d/neozen && \
    chmod 0440 /etc/sudoers.d/neozen

# Set working directory
WORKDIR /app

# Copy application files
COPY --chown=neozen:neozen . .

# Install Python dependencies only (not the package itself)
RUN pip install --no-cache-dir flask>=2.3.0 flask-socketio>=5.3.0 flask-cors>=4.0.0 python-socketio>=5.9.0 python-nmap>=0.7.1 psutil>=5.9.0

# Switch to non-root user
USER neozen

# Set PYTHONPATH to ensure module is found
ENV PYTHONPATH=/app

# Expose web server port
EXPOSE 8080

# Run web server as module (PYTHONPATH is set to /app)
CMD ["python", "-m", "neozen.web.app"]
